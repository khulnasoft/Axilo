{
  "name": "axilo",
  "version": "0.1.0",
  "description": "AI-powered developer assistant and automation platform",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js build",
    "build:dev": "NODE_ENV=development node esbuild.config.js build",
    "build:prod": "NODE_ENV=production node esbuild.config.js build",
    "dev": "pnpm --filter 'packages/*' run dev",
    "test": "pnpm --filter 'packages/*' run test",
    "lint": "pnpm --filter 'packages/*' run lint",
    "lint:fix": "pnpm --filter 'packages/*' run lint:fix",
    "clean": "pnpm --filter 'packages/*' run clean",
    "integration-test": "pnpm integration-test --workspace=integration-tests"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.25.1",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.6.0",
  "keywords": [
    "ai",
    "assistant",
    "automation",
    "cli",
    "developer-tools",
    "typescript"
  ],
  "author": "AXILO",
  "license": "MIT"
}
