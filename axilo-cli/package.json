{
  "private": true,
  "name": "@axilo/cli",
  "version": "0.1.04152057",
  "license": "Apache-2.0",
  "bin": {
    "axilo": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --check src tests",
    "format:fix": "prettier --write src tests",
    "dev": "tsc --watch",
    "lint": "eslint src tests --ext ts --ext tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src tests --ext ts --ext tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "build:dev": "NODE_ENV=development node build.mjs --dev && NODE_OPTIONS=--enable-source-maps node dist/cli-dev.js"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@types/express": "^5.0.1",
    "chalk": "^5.2.0",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "file-type": "^21.1.1",
    "ink": "^6.5.1",
    "ink-select-input": "^6.0.0",
    "marked": "^17.0.1",
    "marked-terminal": "^7.3.0",
    "meow": "^14.0.0",
    "open": "^11.0.0",
    "openai": "^6.13.0",
    "react": "^19.2.3",
    "shell-quote": "^1.8.2",
    "terminal-image": "^4.1.0",
    "use-interval": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/diff": "^8.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/marked-terminal": "^6.1.1",
    "@types/react": "^19.2.7",
    "@types/shell-quote": "^1.7.5",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "esbuild": "^0.27.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.7.4",
    "punycode": "^2.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.3",
    "vitest": "^4.0.15",
    "whatwg-url": "^15.1.0"
  },
  "resolutions": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "semver": "^7.7.1"
  },
  "overrides": {
    "punycode": "^2.3.1"
  }
