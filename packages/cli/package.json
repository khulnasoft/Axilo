{
  "name": "@axilo/cli",
  "version": "0.1.0",
  "description": "AI-powered developer assistant CLI with interactive TUI",
  "main": "dist/index.js",
  "bin": {
    "axilo": "dist/index.js"
  },
  "scripts": {
    "build": "node ../../esbuild.config.js build cli",
    "build:dev": "NODE_ENV=development node ../../esbuild.config.js build cli",
    "build:prod": "NODE_ENV=production node ../../esbuild.config.js build cli",
    "dev": "tsx watch src/index.ts",
    "watch": "node ../../esbuild.config.js watch cli",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axilo/core": "workspace:*",
    "@axilo/a2a-server": "workspace:*",
    "commander": "^11.0.0",
    "ink": "^4.0.0",
    "react": "^18.0.0",
    "react-devtools-core": "^4.28.0",
    "chalk": "^5.0.0",
    "ora": "^7.0.0",
    "inquirer": "^9.0.0",
    "axios": "^1.0.0",
    "open": "^9.0.0",
    "node-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "esbuild": "^0.25.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cli",
    "ai",
    "assistant",
    "tui",
    "react",
    "ink"
  ]
}
