{
  "name": "@axilo/a2a-server",
  "version": "0.1.0",
  "description": "Backend service for AI agents and automation capabilities",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../../esbuild.config.js build a2a-server",
    "build:dev": "NODE_ENV=development node ../../esbuild.config.js build a2a-server",
    "build:prod": "NODE_ENV=production node ../../esbuild.config.js build a2a-server",
    "dev": "tsx watch src/index.ts",
    "watch": "node ../../esbuild.config.js watch a2a-server",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "@google-cloud/storage": "^7.0.0",
    "openai": "^4.0.0",
    "@anthropic-ai/sdk": "^0.18.0",
    "zod": "^3.22.0",
    "uuid": "^9.0.0",
    "ws": "^8.14.0",
    "node-fetch": "^3.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/cors": "^2.8.0",
    "@types/morgan": "^1.9.0",
    "@types/compression": "^1.7.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "esbuild": "^0.25.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "@vitest/coverage-v8": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "automation",
    "backend",
    "http-server"
  ]
}
