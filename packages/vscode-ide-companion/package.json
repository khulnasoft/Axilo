{
  "name": "@axilo/vscode-ide-companion",
  "version": "0.1.0",
  "description": "VS Code extension for AXILO CLI integration - AI-powered development assistance directly in your editor",
  "publisher": "axilo",
  "author": {
    "name": "AXILO Team"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "ai",
    "assistant",
    "cli",
    "vscode",
    "extension",
    "typescript",
    "javascript",
    "productivity"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "assets/icon.png",
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "axilo.openChat",
        "title": "AXILO: Open AI Chat",
        "category": "AXILO"
      },
      {
        "command": "axilo.generateCode",
        "title": "AXILO: Generate Code",
        "category": "AXILO"
      },
      {
        "command": "axilo.analyzeCode",
        "title": "AXILO: Analyze Code",
        "category": "AXILO"
      },
      {
        "command": "axilo.optimizeCode",
        "title": "AXILO: Optimize Code",
        "category": "AXILO"
      },
      {
        "command": "axilo.generateTests",
        "title": "AXILO: Generate Tests",
        "category": "AXILO"
      },
      {
        "command": "axilo.explainCode",
        "title": "AXILO: Explain Code",
        "category": "AXILO"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "axilo.analyzeCode",
          "when": "editorTextFocus",
          "group": "axilo@1"
        },
        {
          "command": "axilo.optimizeCode",
          "when": "editorTextFocus",
          "group": "axilo@2"
        },
        {
          "command": "axilo.generateTests",
          "when": "editorTextFocus",
          "group": "axilo@3"
        },
        {
          "command": "axilo.explainCode",
          "when": "editorTextFocus",
          "group": "axilo@4"
        }
      ],
      "explorer/context": [
        {
          "command": "axilo.generateCode",
          "when": "explorerResourceIsFolder",
          "group": "axilo@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "AXILO Configuration",
      "properties": {
        "axilo.apiKey": {
          "type": "string",
          "description": "API key for AXILO services",
          "default": ""
        },
        "axilo.model": {
          "type": "string",
          "enum": ["gpt-4", "gpt-3.5-turbo", "claude-3-opus", "claude-3-sonnet"],
          "description": "AI model to use for code generation and analysis",
          "default": "gpt-4"
        },
        "axilo.autoComplete": {
          "type": "boolean",
          "description": "Enable AI-powered autocomplete suggestions",
          "default": true
        },
        "axilo.codeReview": {
          "type": "boolean",
          "description": "Enable automatic code review on save",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "check:vscode": "node scripts/check-vscode-release.js",
    "server": "node -r ts-node/register src/ide-server.ts",
    "server:dev": "nodemon --exec 'node -r ts-node/register' src/ide-server.ts",
    "server:prod": "node out/ide-server.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "18.x",
    "@types/express": "^4.17.0",
    "@types/ws": "^8.5.0",
    "@types/cors": "^2.8.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "eslint": "^8.47.0",
    "glob": "^11.1.0",
    "mocha": "^10.2.0",
    "nodemon": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.1.6",
    "@vscode/test-electron": "^2.3.4"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "express": "^4.18.0",
    "ws": "^8.14.0",
    "cors": "^2.8.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axilo/axilo.git"
  },
  "bugs": {
    "url": "https://github.com/axilo/axilo/issues"
  },
  "homepage": "https://github.com/axilo/axilo#readme"
}
